[tox]
# Define a matriz de ambientes: versões intermediárias e checagens de qualidade
envlist = 
    py36,
    py38,
    py310,
    py312,
    lint

# Exige uma versão recente do Tox para suporte total ao Python 3.12
minversion = 4.0

[testenv]
# Garante que dependências de build sejam atualizadas no ambiente virtual
deps =
    pytest >= 7.0
    pytest-cov
    # Carrega dependências específicas de cada versão caso necessário:
    py36: -rrequirements/py36.txt
    py38,py310,py312: -rrequirements/modern.txt

commands =
    pytest {posargs:tests}

[testenv:py36]
# Permite rodar o Python 3.6 ignorando avisos de depreciação de ferramentas do Tox
basepython = python3.6

[testenv:py312]
basepython = python3.12
# No Python 3.12, distutils foi removido. É essencial garantir setuptools atualizado.
deps =
    setuptools >= 68.0.0
    {[testenv]deps}

[testenv:lint]
# O linter e checagens estáticas devem rodar preferencialmente em uma versão moderna
basepython = python3.12
deps =
    ruff
commands =
    ruff check src/ tests/
